          "ORD"
        ]
      },
      "date": {
        "type": "str",
        "required": true,
        "description": "date as YYYY-MM-DD.",
        "sample_values": [
          "2026-11-02"
        ]
      }
    },
    "sample_commands": []
  },
  "order_food_delivery": {
