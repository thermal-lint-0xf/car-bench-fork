{
  "set_home_thermostat": {
    "description": "Set the target temperature of the home thermostat.",
    "domain": "SmartHome",
    "kind": "action",
    "parameters": {
      "temperature_c": {
        "type": "float",
        "required": true,
        "description": "number from 10.0 to 30.0, in steps of 0.5."
      }
    },
    "sample_commands": []
  },
  "set_home_lights": {
    "description": "Turn lights in a room of the home on or off and set their color.",
    "domain": "SmartHome",
    "kind": "action",
    "parameters": {
      "room": {
        "type": "str",
        "required": true,
        "description": "one of \"living_room\", \"bedroom\", \"kitchen\", or \"garden\"."
      },
      "on": {
        "type": "bool",
        "required": true,
        "description": "true to turn on, false to turn off."
      },
      "color": {
        "type": "str",
        "required": false,
        "default": "warm_white",
        "description": "one of \"warm_white\", \"cool_white\", \"red\", \"blue\", or \"green\". Default is \"warm_white\"."
      }
    },
    "sample_commands": []
  },
  "lock_home_door": {
    "description": "Lock or unlock the smart lock on the home's front door.",
    "domain": "SmartHome",
    "kind": "action",
    "parameters": {
      "locked": {
        "type": "bool",
        "required": true,
        "description": "true to lock, false to unlock."
      }
    },
    "sample_commands": []
  },
  "play_on_home_speaker": {
    "description": "Play music on a smart speaker at home.",
    "domain": "SmartHome",
    "kind": "action",
    "parameters": {
      "query": {
        "type": "str",
        "required": true,
        "description": "free text naming what to play.",
        "sample_values": [
          "jazz for dinner"
        ]
      },
      "room": {
        "type": "str",
        "required": true,
        "description": "one of \"living_room\", \"bedroom\", or \"kitchen\"."
      }
    },
    "sample_commands": []
  },
  "start_home_wallbox_charging": {
    "description": "Start charging on the home wallbox app account. This controls the home charger's own app, not the car.",
    "domain": "SmartHome",
    "kind": "action",
    "parameters": {
      "max_current_a": {
        "type": "int",
        "required": true,
        "description": "integer from 6 to 32."
      }
    },
    "sample_commands": []
  },
  "set_phone_alarm": {
    "description": "Set an alarm on the user's phone.",
    "domain": "Phone",
    "kind": "action",
    "parameters": {
      "time": {
        "type": "str",
        "required": true,
        "description": "time as HH:MM on a 24-hour clock.",
        "sample_values": [
          "06:30"
        ]
      }
    },
    "sample_commands": []
  },
  "set_phone_ringer_volume": {
    "description": "Change the phone's own ringer volume.",
    "domain": "Phone",
    "kind": "action",
    "parameters": {
      "level": {
        "type": "int",
        "required": true,
        "description": "integer from 0 to 10."
      }
    },
    "sample_commands": []
  },
  "book_flight": {
    "description": "Search and book a flight ticket.",
    "domain": "Travel",
    "kind": "action",
    "parameters": {
      "origin": {
        "type": "str",
        "required": true,
        "description": "free text city or airport code.",
        "sample_values": [
          "SFO"
        ]
      },
      "destination": {
        "type": "str",
        "required": true,
        "description": "free text city or airport code.",
